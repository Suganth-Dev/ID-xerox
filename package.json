{
  "name": "xeroxmate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs = require('fs'); if (!fs.existsSync('public/opencv.js') && fs.existsSync('node_modules/@techstark/opencv-js/dist/opencv.js')) { fs.copyFileSync('node_modules/@techstark/opencv-js/dist/opencv.js', 'public/opencv.js'); }\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.55.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.4"
  },
  "devDependencies": {
    "@oxlint/binding-win32-x64-msvc": "^1.87.0",
    "@rolldown/binding-win32-x64-msvc": "^1.2.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
